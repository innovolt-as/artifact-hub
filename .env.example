# --- identity ---
SITE_NAME=Martins artifacts
BASE_URL=https://apps.innovolt.no        # used in magic-link e-mails and cookies (secure cookie if https)
SECRET_KEY=change-me-run: python3 -c "import secrets;print(secrets.token_hex(32))"

# --- who may log in ---
ADMIN_EMAILS=you@example.com               # sees admin page + admin_only artifacts
ALLOWED_EMAILS=venn@example.com,kollega@example.com
ALLOWED_DOMAINS=                              # e.g. innovolt.no to allow a whole domain

# --- token for scripts/push.sh (upload without logging in) ---
UPLOAD_TOKEN=change-me-long-random-string

# --- outgoing e-mail (magic links). Leave SMTP_HOST empty to print links in the log instead ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_TLS=starttls                             # starttls | ssl | none
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxx
SMTP_FROM=apps@innovolt.no
