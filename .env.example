# --- identity ---
# Name shown in the page header and e-mails
SITE_NAME=My apps
# Public hostname Caddy serves (needs a DNS A record pointing at this server)
DOMAIN=apps.example.com
# Public URL, used in magic-link e-mails and cookies (secure cookie if https)
BASE_URL=https://apps.example.com
# Signs session cookies; generate with: python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-long-random-string
# Interface language: en (default) or nb (Norwegian bokmål); more in app/lang/
HUB_LANG=en

# --- who may log in ---
# Comma-separated admins: see the admin page and admin_only artifacts
ADMIN_EMAILS=you@example.com
# magic-link (default) sends login links by e-mail; password needs no SMTP: admin sets temporary passwords on the admin page (first admin: docker compose exec hub python -m app.passwd set you@example.com)
LOGIN_MODE=magic-link
# Comma-separated extra e-mail addresses allowed to log in
ALLOWED_EMAILS=
# Comma-separated domains allowed to log in (e.g. example.com), or * to let anyone log in
ALLOWED_DOMAINS=

# --- token for scripts/push.sh (upload without logging in) ---
# Long random secret used as the upload token
UPLOAD_TOKEN=change-me-long-random-string

# --- outgoing e-mail (magic links) ---
# Leave empty to print login links in the log; any SMTP service works (Resend, Postmark, Brevo, Gmail app password)
SMTP_HOST=
# SMTP port (587 for starttls, 465 for ssl)
SMTP_PORT=587
# Connection security: starttls | ssl | none
SMTP_TLS=starttls
# SMTP username
SMTP_USER=
# SMTP password or API key
SMTP_PASS=
# Sender address; must be allowed by your SMTP service
SMTP_FROM=My apps <apps@example.com>
